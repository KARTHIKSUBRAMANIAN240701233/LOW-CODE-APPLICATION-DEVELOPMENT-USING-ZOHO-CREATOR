		menu
		{
			space Space
			{
				displayname = "space"
				icon = "tech-desktop"

				section Home
				{
					displayname = "Home"
					icon = "ui-1-home-minimal"
					page User_Engagement_Dashboard
					{
						icon = "users-2-woman"
					}
				}
				section All_Data
				{
					displayname = "All Data"
					icon = "ui-1-database"
					report Sheet1_Report
					{
						icon = "design-bullet-list-67"
					}
				}
				section Add_New
				{
					displayname = "Add New"
					icon = "ui-1-simple-add"
					form  Data_Source
					{
						icon = "ui-1-bold-add"
					}
				}
				section ZC_App_Preferences
				{
					displayname = "App Preferences"
					icon = "design-app"
					systemcomponent
					{
						type = connection
						displayname = "Connection"
						icon = "tech-2-device-connection"
					}
					systemcomponent
					{
						type = localization
						displayname = "Language Selection"
						icon = "education-language"
					}
				}
				section ZC_Approvals
				{
					displayname = "Approvals"
					icon = "ui-2-hourglass"
					systemcomponent
					{
						type = approval
						approval status = completed
						displayname = "Completed Task"
						icon = "design-todo"
					}
					systemcomponent
					{
						type = approval
						approval status = pending
						displayname = "Pending Task"
						icon = "ui-2-hourglass"
					}
				}
				section SharedAnalytics_Section
				{
					type = shared_user_report_section
					displayname = "Reports"
					icon = "business-chart-bar-33"
				}
				section Meetings
				{
					displayname = "Meetings"
					icon = "business-board-27"
					form  Meetings
					{
						icon = "business-board-27"
					}
					report All_Meetings
					{
						icon = "tech-desktop"
					}
				}
				section Meeting_Minutes
				{
					displayname = "Meeting_Minutes"
					icon = "tech-desktop"
					form  Meeting_Minutes
					{
						icon = "tech-desktop"
					}
					report Meeting_Minutes_Report
					{
						icon = "tech-desktop"
					}
				}
				section Action_Items
				{
					displayname = "Action_Items"
					icon = "tech-desktop"
					form  Action_Items
					{
						icon = "tech-desktop"
					}
					report Action_Items_Report
					{
						icon = "tech-desktop"
					}
				}
				section Team_Members
				{
					displayname = "Team_Members"
					icon = "tech-desktop"
					form  Team_Members
					{
						icon = "tech-desktop"
					}
					report Team_Members_Report
					{
						icon = "tech-desktop"
					}
				}
			}
			preference
			{
				icon
				{
					style = outline
					show = {section,component}
				}
			}
		}
