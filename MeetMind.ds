				on success
				{
					actions 
					{
						custom deluge script
						(
											info "MeetMind: Action item record updated successfully.";
										info "Please verify the latest task status.";
						)
					}
				}

			}
			Team_Member_Registration as "Team_Member_Registration"
			{
				type =  form
				form = Team_Members

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											info "MeetMind: New team member registered successfully.";
										info "Team member record has been saved.";
						)
					}
				}

			}
		}

		schedule
		{
			Upcoming_Meeting_Reminder as "Upcoming_Meeting_Reminder"
			{
				type =  schedule
				form = Meetings
					status = inactive
				start = Meeting_Date at "07:10:00"
				end   = Meeting_Date
				frequency = daily
				time zone = "UTC"
				on start
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "karthiksubramanian.s.2024.cse@rajalakshmi.edu.in"
							subject : "Upcoming MeetMind Meeting"
							message : "<p><span>Hello,</span><br></p><p><span>This is a friendly reminder that you have an upcoming meeting scheduled in MeetMind.</span><br></p><p><span>Please check your meeting details and make sure you are available on time.</span><br></p><p><span>Kindly review the meeting agenda and prepare any necessary discussion points.</span><br></p><p></p><div><span>Thank you,</span><br></div><div><b><span>MeetMind Team</span></b><br></div><p></p><div><br></div>"
							attachments : view : All_Meetings as PDF
						)
					}
				}
			}
