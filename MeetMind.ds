 application "MeetMind"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "UTC"
 	time format = "24-hr"

 	forms
	{
		form Action_Items
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Action_field
			(
    			type = text
				displayname = "Action Title"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Assigned_to
			(
    			type = text
				displayname = "Assigned To"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Due_Date
			(
    			type = date
				displayname = "Due Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Action_Status
			(
				type = picklist
				displayname = "Action Status"
				maxchar = 100
				values = {"Pending","In Progress","Completed","On Hold"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Action_De
			(
    			type = textarea
				displayname = "Action Description "
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Priority
			(
				type = picklist
				maxchar = 100
				values = {"High","Medium","Low"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Team_Members
			(
				type = picklist	
				values  = Team_Members.ID
    			displayformat = [Member_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Data_Source
		{
			displayname = "Data Source"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<p class=\"zw-paragraph heading0\" style=\"margin: 0px 0px 0pt; line-height: 1.2; text-align: left; direction: ltr\"><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\">💡 </span><span class=\"size\" style=\"font-size: 12pt; font-weight: 600; vertical-align: baseline\">Creator tip:</span><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\"> Use this sample form to capture data. Below is an example of how it may look.</span></span></span><br /></p><p class=\"zw-paragraph heading0\" style=\"margin: 0px 0px 0pt; line-height: 1.2; text-align: left; direction: ltr\"><br /></p><div><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\">Feel free to tweak things via the </span></span></span><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\">form builder. Every form submission is recorded in a </span></span></span><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\">r</span></span></span><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\">eport and can be visuali</span></span></span><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\">z</span></span></span><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\">ed.</span></span></span><br /></div><p class=\"zw-paragraph heading0\" style=\"margin: 0px 0px 0pt; line-height: 1.2; text-align: left; direction: ltr\"><span class=\"EOP\">&nbsp;</span><br /></p><div><span class=\"highlight\" style=\"background-color: rgba(0, 0, 0, 0)\"><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; font-variant: normal; text-decoration: none; letter-spacing: 0pt; font-weight: 400; vertical-align: baseline; font-style: normal\">Note: If you're capturing sensitive data via a field, take a look at the field's properties to make </span></span></span></span><span class=\"highlight\" style=\"background-color: rgba(0, 0, 0, 0)\"><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; letter-spacing: 0pt\">sure </span></span></span></span><span class=\"highlight\" style=\"background-color: rgba(0, 0, 0, 0)\"><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; font-variant: normal; text-decoration: none; letter-spacing: 0pt; font-weight: 400; vertical-align: baseline; font-style: normal\">it</span></span></span></span><span class=\"highlight\" style=\"background-color: rgba(0, 0, 0, 0)\"><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; letter-spacing: 0pt\">'s</span></span></span></span><span class=\"highlight\" style=\"background-color: rgba(0, 0, 0, 0)\"><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; font-variant: normal; text-decoration: none; letter-spacing: 0pt; font-weight: 400; vertical-align: baseline; font-style: normal\"> secured.</span></span></span></span><br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Date1
			(
    			type = date
				displayname = "Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Total_Users
			(
				type = number
				displayname = "Total Users"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Active_Today
			(
				type = number
				displayname = "Active Today"
	 			row = 1
	 			column = 1   
				width = medium
			)
			New_Registrations
			(
				type = number
				displayname = "New Registrations"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Support_Tickets
			(
				type = number
				displayname = "Support Tickets"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Open_Tickets
			(
				type = number
				displayname = "Open Tickets"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Avg_Response_Time_hrs
			(
				type = decimal
				displayname = "Avg Response Time (hrs)"
				decimalplace = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			System_Uptime
			(
				type = decimal
				displayname = "System Uptime (%)"
				decimalplace = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			New_Subscriptions
			(
				type = number
				displayname = "New Subscriptions"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Revenue
			(
				type = number
				displayname = "Revenue ($)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Top_Issue_Category
			(
				type = picklist
				displayname = "Top Issue Category"
				values = {"Account Recovery","Billing Issue","Connectivity","Login Issues","Payment Processing","Server Error","User Interface"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Server_Load
			(
				type = decimal
				displayname = "Server Load (%)"
				decimalplace = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Data_Usage_TB
			(
				type = decimal
				displayname = "Data Usage (TB)"
				decimalplace = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			User_Satisfaction
			(
				type = decimal
				displayname = "User Satisfaction (%)"
				decimalplace = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Meeting_Minutes
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Meetings
			(
				type = picklist	
				values  = Meetings.ID
    			displayformat = [Meeting_Title]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Meeting_Title
			(
    			type = text
				displayname = "Meeting Title"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Meeting_Date
			(
    			type = date
				displayname = "Meeting Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Meeting_Notes
			(
    			type = textarea
				displayname = "Meeting Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Decisions
			(
    			type = textarea
				displayname = "Decisions Taken"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Meeting_Summary
			(
    			type = textarea
				displayname = "Meeting Summary"
				height = 150px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Keyword
			(
    			type = textarea
				displayname = "Extracted_Keywords"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = KeywordExtractor
									basefield = Meeting_Notes
						)
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Meetings
		{
			success message = "Meeting Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Meeting_Title
			(
    			type = text
				displayname = "Meeting Title"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Meeting_Date
			(
    			type = date
				displayname = "Meeting  Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Meeting_Time
			(
    			type = time
				displayname = "Meeting Time "
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			Meeting_Agenda
			(
    			type = textarea
				displayname = "Meeting Agenda"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Meeting_Location
			(
    			type = text
				displayname = "Meeting Location"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Meeting_Organizer
			(
    			type = text
				displayname = "Meeting Organizer"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Meeting_Status
			(
				type = picklist
				displayname = "Meeting Status"
				maxchar = 100
				values = {"Scheduled","In Progress","Completed","Cancelled"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Team_Members
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Member_Name
			(
    			type = text
				displayname = "Member Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Member_Email
			(
    			type = email
				displayname = "Member Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Member_Role
			(
				type = picklist
				displayname = "Member Role"
				maxchar = 100
				values = {"Admin","Manager","Team Member"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Member_Department
			(
    			type = text
				displayname = "Member Department"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Member_Status
			(
				type = picklist
				displayname = "Member Status"
				maxchar = 100
				values = {"Active","Inactive"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Meetings
		{
			displayName = "All Meetings"
			show all rows from Meetings    
			(
				Meeting_Title as "Meeting Title"
				Meeting_Date as "Meeting  Date"
				Meeting_Time as "Meeting Time "
				Meeting_Agenda as "Meeting Agenda"
				Meeting_Location as "Meeting Location"
				Meeting_Organizer as "Meeting Organizer"
				Meeting_Status as "Meeting Status"
			)
		}
		default list Meeting_Minutes_Report
		{
			displayName = "Meeting_Minutes Report"
			show all rows from Meeting_Minutes    
			(
				Meeting_Title as "Meeting Title"
				Meeting_Date as "Meeting Date"
				Meeting_Notes as "Meeting Notes"
				Decisions as "Decisions Taken"
				Meeting_Summary as "Meeting Summary"
				Meetings
				Keyword as "Extracted_Keywords"
			)
		}
		default list Action_Items_Report
		{
			displayName = "Action_Items Report"
			show all rows from Action_Items    
			(
				Action_field as "Action Title"
				Assigned_to as "Assigned To"
				Due_Date as "Due Date"
				Action_Status as "Action Status"
				Action_De as "Action Description "
				Priority
				Team_Members
			)
		}
		default list Team_Members_Report
		{
			displayName = "Team_Members Report"
			show all rows from Team_Members    
			(
				Member_Name as "Member Name"
				Member_Email as "Member Email"
				Member_Role as "Member Role"
				Member_Department as "Member Department"
				Member_Status as "Member Status"
			)
		}
		list Sheet1_Report
		{
			displayName = "All Data Points"
			show all rows from Data_Source    
			(
				Date1 as "Date"
				(
					width = 113px
				)
				Total_Users as "Total Users"
				(
					width = 126px
				)
				Active_Today as "Active Today"
				(
					width = 145px
				)
				New_Registrations as "New Registrations"
				(
					width = 175px
				)
				Support_Tickets as "Support Tickets"
				(
					width = 152px
				)
				Open_Tickets as "Open Tickets"
				(
					width = 148px
				)
				Avg_Response_Time_hrs as "Avg Response Time (hrs)"
				(
					width = 216px
				)
				System_Uptime as "System Uptime (%)"
				(
					width = 173px
				)
				New_Subscriptions as "New Subscriptions"
				(
					width = 174px
				)
				Revenue as "Revenue ($)"
				(
					width = 133px
				)
				Top_Issue_Category as "Top Issue Category"
				(
					width = 175px
				)
				Server_Load as "Server Load (%)"
				(
					width = 152px
				)
				Data_Usage_TB as "Data Usage (TB)"
				(
					width = 160px
				)
				User_Satisfaction as "User Satisfaction (%)"
				(
					width = 185px
				)
			)
		}
	}
	pages
	{
		page User_Engagement_Dashboard
		{
